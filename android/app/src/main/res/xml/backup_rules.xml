<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy Android Auto Backup Rules (API < 31) -->
<full-backup-content>
    <!-- Strictly exclude encrypted Vault storage, authentication credentials, databases, and secure preferences -->
    <exclude domain="file" path=".filezen_vault" />
    <exclude domain="file" path="app_flutter/.filezen_vault" />
    <exclude domain="file" path="app_flutter/.filezen_monetization.json" />
    <exclude domain="file" path="vault" />
    <exclude domain="database" path="app_database.sqlite" />
    <exclude domain="sharedpref" path="FlutterSecureStorage" />
    <exclude domain="sharedpref" path="flutter_secure_storage" />
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
</full-backup-content>
